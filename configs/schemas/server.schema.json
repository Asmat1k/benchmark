{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "server v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "warmup": {
      "type": "object",
      "properties": {
        "received": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "write_attempted": {
          "type": "integer",
          "minimum": 0
        },
        "echoed": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "received",
        "invalid",
        "write_attempted",
        "echoed",
        "errors"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "received": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "write_attempted": {
          "type": "integer",
          "minimum": 0
        },
        "echoed": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "received",
        "invalid",
        "write_attempted",
        "echoed",
        "errors"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "warmup",
    "measurement"
  ],
  "additionalProperties": false
}
