{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gate": {
      "enum": [
        "build",
        "tls",
        "path",
        "raw",
        "analysis",
        "reproduction",
        "timer",
        "generator",
        "calibration"
      ]
    },
    "collection_id": {
      "type": "string",
      "minLength": 1
    },
    "values": {
      "type": "object"
    },
    "clock_samples_ms": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 100001,
      "maxItems": 100001
    },
    "document": {
      "type": "object"
    },
    "observations": {
      "type": "object",
      "minProperties": 1
    }
  },
  "required": ["gate", "collection_id"],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": ["document", "observations"]
    },
    {
      "required": ["values"]
    }
  ]
}
