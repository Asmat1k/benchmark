{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "series_id": {
      "type": "string",
      "minLength": 1
    },
    "block_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "enum": ["smoke", "verify", "diagnostic", "pilot", "main"]
    },
    "mode": {
      "enum": ["WS", "WT-S", "WT-D"]
    },
    "profile": {
      "enum": ["r20p0", "r20p1", "r80p0", "r80p1", "baseline"]
    },
    "nonce": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Canonical decimal uint64; readers must also check the upper bound 18446744073709551615."
    },
    "order_index": {
      "type": "integer",
      "minimum": 0
    },
    "replacement_of": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "started_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "ended_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "dirty": {
      "type": "boolean"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schedule_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "forward_seed": {
      "type": "integer",
      "minimum": 0
    },
    "reverse_seed": {
      "type": "integer",
      "minimum": 0
    },
    "provenance": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "network_before": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "network_after": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "technical_valid": {
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "monitoring": {
      "enum": ["on", "off"]
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "run_id",
    "series_id",
    "block_id",
    "session_id",
    "attempt_id",
    "series",
    "mode",
    "profile",
    "nonce",
    "order_index",
    "replacement_of",
    "started_utc",
    "ended_utc",
    "commit",
    "dirty",
    "protocol_sha256",
    "config_sha256",
    "schedule_sha256",
    "forward_seed",
    "reverse_seed",
    "provenance",
    "environment",
    "network_before",
    "network_after",
    "security",
    "technical_valid",
    "reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "baseline"
          }
        }
      },
      "then": {
        "properties": {
          "series": {
            "enum": ["smoke", "diagnostic", "verify"]
          }
        }
      }
    }
  ]
}
