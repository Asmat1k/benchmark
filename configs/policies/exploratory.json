{
  "execution_policy": "exploratory-browser-study-v2",
  "scope": "exploratory-observed-system",
  "design": {
    "blocks_per_profile": 20,
    "sessions": 4,
    "runs": 240,
    "modes": [
      "WS",
      "WT-S",
      "WT-D"
    ],
    "profiles": [
      "r20p0",
      "r20p1",
      "r80p0",
      "r80p1"
    ],
    "sample": "fixed-all-planned-outcomes"
  },
  "limits": {
    "series_budget_seconds": 54000,
    "run_timeout_seconds": 360,
    "cleanup_timeout_seconds": 30,
    "checkpoint_interval_ms": 2000
  },
  "outcomes": [
    "planned",
    "running",
    "complete",
    "rejected",
    "failed",
    "interrupted"
  ],
  "retries": false,
  "replacements": false,
  "observations": [
    "send-lag",
    "late-replies",
    "missing",
    "disconnect",
    "post-measurement-queues",
    "cpu-recovery"
  ],
  "mandatory_integrity": [
    "identity",
    "clock",
    "schema",
    "hash",
    "path",
    "tls",
    "resource-coverage",
    "log-completeness"
  ],
  "unknown": "unavailable-not-measured-loss",
  "inference": "all-planned-valid-comparison-runs-only",
  "historical": {
    "calibration": "failed",
    "generator": "failed",
    "aa": "partial",
    "monitoring": "not_run",
    "pilot": "not_run",
    "power": "not_run",
    "reproduction": "not_run"
  },
  "limitations": [
    "no-confirmatory-readiness",
    "no-80-percent-power-claim",
    "no-universal-transport-winner"
  ]
}
