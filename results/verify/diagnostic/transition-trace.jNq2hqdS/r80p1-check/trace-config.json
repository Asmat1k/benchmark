{
  "events": {
    "sched/sched_switch": "prev_pid == 10838 || next_pid == 10838",
    "sched/sched_wakeup": "pid == 10838",
    "sched/sched_waking": "pid == 10838",
    "syscalls/sys_enter_recvfrom": "common_pid == 10838",
    "syscalls/sys_exit_recvfrom": "common_pid == 10838",
    "syscalls/sys_enter_sendto": "common_pid == 10838",
    "syscalls/sys_exit_sendto": "common_pid == 10838",
    "net/net_dev_queue": "name == \"to_server\" || name == \"to_browser\"",
    "net/net_dev_start_xmit": "name == \"to_server\" || name == \"to_browser\"",
    "net/net_dev_xmit": "name == \"to_server\" || name == \"to_browser\"",
    "net/netif_receive_skb": "name == \"to_server\" || name == \"to_browser\" || name == \"bench0\"",
    "qdisc/qdisc_enqueue": "(ifindex == 14 || ifindex == 13)",
    "qdisc/qdisc_dequeue": "(ifindex == 14 || ifindex == 13)"
  },
  "clock": "local global counter uptime perf [mono] mono_raw boot tai\n",
  "buffer_kb_per_cpu": 16384,
  "overwrite": false,
  "timeout_seconds": 160,
  "qdisc_ifindex_namespace_ambiguous": true
}
