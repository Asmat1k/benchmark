FROM debian:bookworm-slim@sha256:ec8534cda2cb30f29f44f23e135297af7a1496f2990fd8e4e84aa36b081a757a AS compiler
RUN apt-get -o Acquire::Retries=4 update && apt-get -o Acquire::Retries=4 install -y --no-install-recommends build-essential pkg-config flex bison libmnl-dev libelf-dev libcap-dev curl ca-certificates xz-utils
WORKDIR /tmp
RUN curl -fsSLO https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-6.15.0.tar.xz && echo '8041854a882583ad5263466736c9c8c68c74b1a35754ab770d23343f947528fb  iproute2-6.15.0.tar.xz' | sha256sum -c - && tar xf iproute2-6.15.0.tar.xz && cd iproute2-6.15.0 && ./configure && make -j2 && make DESTDIR=/opt/router install
FROM debian:bookworm-slim@sha256:ec8534cda2cb30f29f44f23e135297af7a1496f2990fd8e4e84aa36b081a757a
RUN apt-get -o Acquire::Retries=4 update && apt-get -o Acquire::Retries=4 install -y --no-install-recommends ethtool tcpdump libmnl0 libelf1 libcap2 iptables jq && rm -rf /var/lib/apt/lists/*
COPY --from=compiler /opt/router/sbin/ip /opt/router/sbin/tc /usr/local/sbin/
COPY docker/check-seed.sh /usr/local/bin/check-seed
COPY docker/network.sh /usr/local/bin/network
ENTRYPOINT ["sh","/usr/local/bin/network"]
