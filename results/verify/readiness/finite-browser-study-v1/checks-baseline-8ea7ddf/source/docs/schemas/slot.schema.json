{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "slot v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        0,
        1
      ]
    },
    "nonce": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Canonical decimal uint64; readers must also check the upper bound 18446744073709551615."
    },
    "seq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Canonical decimal uint64; readers must also check the upper bound 18446744073709551615."
    },
    "t_plan_ms": {
      "type": "number",
      "minimum": 0
    },
    "t_send_ms": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "send_lag_ms": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "api_return_ms": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "write_fulfilled_ms": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "send_state": {
      "enum": [
        "sent",
        "scheduler_miss",
        "local_api_error",
        "local_backpressure_error",
        "not_sent_after_disconnect"
      ]
    },
    "bytes": {
      "const": 256
    },
    "queue_before_bytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "desired_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_correct_echo_ms": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "echo_bytes": {
      "anyOf": [
        {
          "const": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_by_horizon": {
      "type": "boolean"
    },
    "ontime": {
      "type": "boolean"
    },
    "terminal_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "phase",
    "nonce",
    "seq",
    "t_plan_ms",
    "t_send_ms",
    "send_lag_ms",
    "api_return_ms",
    "write_fulfilled_ms",
    "send_state",
    "bytes",
    "queue_before_bytes",
    "desired_size",
    "first_correct_echo_ms",
    "echo_bytes",
    "completed_by_horizon",
    "ontime",
    "terminal_reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ontime": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "completed_by_horizon": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completed_by_horizon": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "t_send_ms": {
            "type": "number",
            "minimum": 0
          },
          "first_correct_echo_ms": {
            "type": "number",
            "minimum": 0
          },
          "echo_bytes": {
            "const": 256
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "send_state": {
            "enum": [
              "scheduler_miss",
              "local_backpressure_error",
              "not_sent_after_disconnect"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "t_send_ms": {
            "const": null
          },
          "completed_by_horizon": {
            "const": false
          }
        }
      }
    }
  ]
}
