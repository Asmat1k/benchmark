{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "completion v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "measurement_rows": {
      "type": "integer",
      "minimum": 0
    },
    "warmup_rows": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "measurement_rows",
    "warmup_rows",
    "reason"
  ],
  "additionalProperties": false
}
