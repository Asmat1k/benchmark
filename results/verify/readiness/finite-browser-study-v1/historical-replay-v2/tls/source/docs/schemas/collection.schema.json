{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "real",
        "synthetic"
      ]
    },
    "gate": {
      "enum": [
        "build",
        "tls",
        "path",
        "raw",
        "analysis",
        "reproduction",
        "timer",
        "generator",
        "calibration"
      ]
    },
    "collection_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "source_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "gate",
    "collection_id",
    "environment",
    "source_hashes",
    "payload"
  ],
  "additionalProperties": false
}
