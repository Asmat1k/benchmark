{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "checks v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mandatory": {
            "type": "boolean"
          },
          "expected": {},
          "actual": {},
          "units": {
            "type": "string",
            "minLength": 1
          },
          "tolerance": {},
          "status": {
            "enum": [
              "not_run",
              "passed",
              "failed",
              "inconclusive"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "utc": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "mandatory",
          "expected",
          "actual",
          "units",
          "tolerance",
          "status",
          "reason",
          "utc",
          "evidence"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_run"
                }
              }
            },
            "then": {
              "properties": {
                "actual": {
                  "const": null
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "failed"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "actual": {
                  "not": {
                    "const": null
                  }
                },
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "checks"
  ],
  "additionalProperties": false
}
