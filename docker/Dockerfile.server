FROM node:22.18.0-bookworm AS client
WORKDIR /client
COPY src/client/package*.json ./
RUN npm ci
COPY src/client ./
RUN npm run build && npm test && cp index.html dist/
FROM golang:1.24.6-bookworm AS compiler
WORKDIR /src
COPY src/server/go.* ./
RUN go mod download
COPY src/server ./
RUN go test -mod=readonly ./... && CGO_ENABLED=0 go build -mod=readonly -o /bench . && CGO_ENABLED=0 go build -o /testcert ./cmd/testcert
RUN go version -m /bench > /server-build.txt && sha256sum /bench /testcert go.mod go.sum >> /server-build.txt
FROM debian:bookworm-slim
COPY --from=compiler /server-build.txt /server-build.txt
COPY --from=client /client/dist /page
COPY --from=compiler /bench /testcert /usr/local/bin/
ENTRYPOINT ["bench"]
