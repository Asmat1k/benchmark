FROM python:3.12.11-slim-bookworm@sha256:9bb659dc6d5218917236f3711e866a5634bb4c2f208de9d4533aa4863f57c1d3
WORKDIR /analysis
COPY src/analysis/requirements.txt ./
RUN pip download --no-cache-dir --require-hashes --only-binary=:all: -r requirements.txt -d /wheelhouse && cd /wheelhouse && sha256sum *.whl > SHA256SUMS
RUN --network=none cd /wheelhouse && sha256sum -c SHA256SUMS && pip install --no-index --find-links=/wheelhouse --require-hashes --only-binary=:all: -r /analysis/requirements.txt && pip check
COPY src/analysis/ ./
ENV MPLBACKEND=Agg
